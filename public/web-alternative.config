<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- API routes - proxy to backend -->
        <rule name="API Routes" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="https://creativuk-app.paldev.tech/api/{R:1}" />
        </rule>
        
        <!-- Static assets - serve directly -->
        <rule name="Static Assets" stopProcessing="true">
          <match url="^(.*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))$" />
          <action type="None" />
        </rule>
        
        <!-- Specific app routes that should serve index.html -->
        <rule name="App Routes" stopProcessing="true">
          <match url="^(calculator|pricing|contract-generation|solar-workflow|template-selection|customer-details|flux-calculator|dynamic-inputs|solar-arrays|contract-signing|installation-booking|presentation|survey|payment|admin|debug|opportunity|opensolar|signcom|adobe-sign|direct-docuseal|disclaimer-signing|express-consent|booking-confirmation|email-confirmation|docuseal-signing|flux-template|flux-radio|flux-inputs|solar-projection|welcome-email|finish-appointment|free-document-signing|contract-signing-test|docu-sign-test|pdf-signing-test|pipeline-test|all-opportunities|contact-appointments|test-opportunities|opportunities-with-appointments|statistics|debug/auth|debug/sign|debug/opensolar|docuseal|login|register|forgot-password|dashboard|opportunities|progress|profile)(.*)$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
        
        <!-- Root and other routes -->
        <rule name="Root and Other Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
